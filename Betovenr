-- Arrastar o Painel
local arrastando, inicioArrasto, posicaoInicial

local function iniciarArrasto(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		arrastando = true
		inicioArrasto = input.Position
		posicaoInicial = painel.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				arrastando = false
			end
		end)
	end
end

painel.InputBegan:Connect(iniciarArrasto)
tituloBarra.InputBegan:Connect(iniciarArrasto)

UserInputService.InputChanged:Connect(function(input)
	if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and arrastando then
		local delta = input.Position - inicioArrasto
		painel.Position = UDim2.new(posicaoInicial.X.Scale, posicaoInicial.X.Offset + delta.X, posicaoInicial.Y.Scale, posicaoInicial.Y.Offset + delta.Y)
	end
end)

