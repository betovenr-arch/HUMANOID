local function recalcularTamanhoPainel()
	local alturaFinal = 195

	if listaFrame.Visible then
		alturaFinal = alturaFinal + 95
		botaoTipoHitbox.Position = UDim2.new(0, 10, 0, 210)
		listaTipoFrame.Position = UDim2.new(0, 10, 0, 244)
	else
		botaoTipoHitbox.Position = UDim2.new(0, 10, 0, 116)
		listaTipoFrame.Position = UDim2.new(0, 10, 0, 150)
	end

	if listaTipoFrame.Visible then
		alturaFinal = alturaFinal + 60
	end

	if painelAberto then
		tween(painel, 0.2, {Size = UDim2.new(0, 200, 0, alturaFinal)})
	end
end

local function atualizarListaGUI()
	for _, child in ipairs(listaFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local isAllSelected = jogadoresSelecionados["All"]
	local btnAll = Instance.new("TextButton")
	btnAll.Size = UDim2.new(1, 0, 0, 24)
	btnAll.BackgroundColor3 = isAllSelected and Color3.fromRGB(0, 80, 60) or Color3.fromRGB(25, 30, 40)
	btnAll.TextColor3 = isAllSelected and Color3.fromRGB(0, 255, 180) or Color3.fromRGB(150, 170, 190)
	btnAll.TextSize = 10
	btnAll.Font = Enum.Font.GothamBold
	btnAll.Text = (isAllSelected and " [✓] " or " [ ] ") .. "TODOS OS PLAYERS"
	btnAll.ZIndex = 6
	btnAll.Parent = listaFrame

	btnAll.MouseButton1Click:Connect(function()
		if jogadoresSelecionados["All"] then
			jogadoresSelecionados["All"] = nil
		else
			jogadoresSelecionados = { ["All"] = true }
		end
		atualizarListaGUI()
		atualizarTodos()
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local isSelected = jogadoresSelecionados[player] or (jogadoresSelecionados["All"])
			local btnPlayer = Instance.new("TextButton")
			btnPlayer.Size = UDim2.new(1, 0, 0, 24)
			btnPlayer.BackgroundColor3 = isSelected and Color3.fromRGB(0, 60, 90) or Color3.fromRGB(25, 30, 40)
			btnPlayer.TextColor3 = isSelected and Color3.fromRGB(0, 220, 255) or Color3.fromRGB(150, 170, 190)
			btnPlayer.TextSize = 10
			btnPlayer.Font = Enum.Font.Gotham
			btnPlayer.Text = (isSelected and " [✓] " or " [ ] ") .. player.DisplayName
			btnPlayer.ZIndex = 6
			btnPlayer.Parent = listaFrame

			btnPlayer.MouseButton1Click:Connect(function()
				if jogadoresSelecionados["All"] then
					jogadoresSelecionados["All"] = nil
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer then
							jogadoresSelecionados[p] = true
						end
					end
				end

				jogadoresSelecionados[player] = not jogadoresSelecionados[player] or nil
				atualizarListaGUI()
				atualizarTodos()
			end)
		end
	end
end

