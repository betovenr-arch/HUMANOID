local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local estadoAtivo = true
local tamanhoHitbox = 15
local parteSelecionada = "HEAD" -- "HEAD" ou "TORSO"
local jogadoresSelecionados = { ["All"] = true }
local painelAberto = true

local propriedadesOriginais = {}

-- Função para animação suave
local function tween(instancia, tempo, propriedades)
	local info = TweenInfo.new(tempo, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	local anim = TweenService:Create(instancia, info, propriedades)
	anim:Play()
	return anim
end

-- Pega a parte certa do corpo (Suporta R6 e R15)
local function obterParteDoCorpo(character, tipoParte)
	if not character then return nil end
	if tipoParte == "HEAD" then
		return character:FindFirstChild("Head")
	elseif tipoParte == "TORSO" then
		return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	end
	return nil
end

-- Restaura o tamanho original das partes do corpo
local function restaurarPersonagem(character)
	if not character then return end
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and propriedadesOriginais[part] then
			part.Size = propriedadesOriginais[part].Size
			part.Transparency = propriedadesOriginais[part].Transparency
			part.CanCollide = propriedadesOriginais[part].CanCollide
		end
	end
end

-- Atualiza a Hitbox do jogador
local function atualizarPlayer(player)
	if player == LocalPlayer then return end
	
	local character = player.Character
	if not character then return end
	
	restaurarPersonagem(character)

	local parteAlvo = obterParteDoCorpo(character, parteSelecionada)
	if not parteAlvo or not parteAlvo:IsA("BasePart") then return end

	if not propriedadesOriginais[parteAlvo] then
		propriedadesOriginais[parteAlvo] = {
			Size = parteAlvo.Size,
			Transparency = parteAlvo.Transparency,
			CanCollide = parteAlvo.CanCollide
		}
	end

	local deveAplicar = estadoAtivo and (jogadoresSelecionados["All"] or jogadoresSelecionados[player])

	if deveAplicar then
		parteAlvo.Size = Vector3.new(tamanhoHitbox, tamanhoHitbox, tamanhoHitbox)
		parteAlvo.Transparency = 0.6
		
		-- Para a parte de HEAD manter original, e para TORÇO não travar
		if parteSelecionada == "TORSO" then
			parteAlvo.CanCollide = false
		end
	end
end

local function atualizarTodos()
	for _, player in ipairs(Players:GetPlayers()) do
		atualizarPlayer(player)
	end
end

local function monitorarJogador(player)
	if player == LocalPlayer then return end
	
	if player.Character then
		task.spawn(function()
			atualizarPlayer(player)
		end)
	end

	player.CharacterAdded:Connect(function(char)
		task.wait(0.3)
		atualizarPlayer(player)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	monitorarJogador(player)
end

Players.PlayerAdded:Connect(function(player)
	monitorarJogador(player)
end)

